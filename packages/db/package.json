{
  "name": "@staybuddy/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/cli.ts migrate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/postgres.integration.test.ts",
    "test:integration": "vitest run test/postgres.integration.test.ts"
  },
  "dependencies": {
    "@staybuddy/contracts": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
