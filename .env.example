NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://staybuddy:staybuddy@localhost:5432/staybuddy
REDIS_URL=redis://localhost:6379
PUBLIC_BASE_URL=http://localhost:4000
BOOTSTRAP_PRIVATE_KEY_HEX=replace-with-64-hex-character-ed25519-private-key
BOOTSTRAP_PUBLIC_KEY_HEX=replace-with-64-hex-character-ed25519-public-key
EMAIL_LOOKUP_HMAC_SECRET=replace-with-at-least-32-random-bytes
PII_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
OTP_PEPPER=replace-with-at-least-32-random-bytes
GUEST_JWT_SECRET=replace-with-at-least-32-random-bytes
STAFF_JWT_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_CLIENT_IDS=replace-with-hotel-app-google-client-ids
APPLE_CLIENT_IDS=replace-with-hotel-app-apple-service-or-bundle-ids
SES_FROM_EMAIL=concierge@example.com
AWS_REGION=ap-southeast-1
