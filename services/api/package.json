{
  "name": "@staybuddy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/api.integration.test.ts",
    "test:integration": "vitest run test/api.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1121.0",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@staybuddy/contracts": "workspace:*",
    "@staybuddy/db": "workspace:*",
    "@staybuddy/domain": "workspace:*",
    "@staybuddy/observability": "workspace:*",
    "@staybuddy/pms-sdk": "workspace:*",
    "fastify": "^5.12.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "^6.2.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
